/*
===============================================================================
Script: 03_bronze_load_pipeline.sql

Purpose:
    Loads raw data from CSV files into the Bronze layer tables.

Layer:
    Bronze

Description:
    The Bronze layer stores data as close to the source as possible.
    No business transformations or data cleaning are performed during
    the loading process.

Process:
    1. Truncate existing Bronze tables.
    2. Load raw data from CSV files using PostgreSQL COPY.
    3. Preserve the original source data for further processing in the
       Silver layer.

Prerequisites:
    - PostgreSQL and pgAdmin containers must be running.
    - The datasets directory must be mounted into the PostgreSQL container.
    - Bronze tables must already exist.
===============================================================================
*/

-- ============================================================================
-- CRM: Customer Info
-- ============================================================================
TRUNCATE TABLE bronze.crm_cust_info;

COPY bronze.crm_cust_info
FROM '/datasets/source_crm/cust_info.csv'
WITH (
	FORMAT CSV,
	HEADER TRUE,
	DELIMITER ','
);

-- ============================================================================
-- CRM: Product Info
-- ============================================================================
TRUNCATE TABLE bronze.crm_prd_info;

COPY bronze.crm_prd_info
FROM '/datasets/source_crm/prd_info.csv'
WITH (
	FORMAT CSV,
	HEADER TRUE,
	DELIMITER ','
);

-- ============================================================================
-- CRM: Sales details
-- ============================================================================
TRUNCATE TABLE bronze.crm_sales_details;

COPY bronze.crm_sales_details
FROM '/datasets/source_crm/sales_details.csv'
WITH (
	FORMAT CSV,
	HEADER TRUE,
	DELIMITER ','
);

-- ============================================================================
-- ERP: Cust az12
-- ============================================================================
TRUNCATE TABLE bronze.erp_cust_az12;

COPY bronze.erp_cust_az12
FROM '/datasets/source_erp/CUST_AZ12.csv'
WITH (
	FORMAT CSV,
	HEADER TRUE,
	DELIMITER ','
);

-- ============================================================================
-- ERP: Loc A101
-- ============================================================================
TRUNCATE TABLE bronze.erp_loc_a101;

COPY bronze.erp_loc_a101
FROM '/datasets/source_erp/LOC_A101.csv'
WITH (
	FORMAT CSV,
	HEADER TRUE,
	DELIMITER ','
);

-- ============================================================================
-- ERP: Px Cat g1v2
-- ============================================================================
TRUNCATE TABLE bronze.erp_px_cat_g1v2;

COPY bronze.erp_px_cat_g1v2
FROM '/datasets/source_erp/PX_CAT_G1V2.csv'
WITH (
